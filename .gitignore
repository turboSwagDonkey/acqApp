# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Acquisition data / outputs (never commit experiment data) ---
sessions/
# Saved photostimulation ROI sets (devices/dmd/roi_store.py) — rig- and
# calibration-specific, like acqapp_local.json, so not portable across rigs.
/rois/
*.tif
*.tiff
*.h5
*.hdf5
*.raw
*.npy
*.csv

# --- Build / transfer artifacts ---
# The repo is how code moves between the laptop and the rig now; a tarball of a
# snapshot only ever goes stale (acqapp_phase1_2.tar.gz was six weeks out of
# date and still in the tree).
*.tar.gz
*.zip

# --- Logs / config local overrides ---
*.log
*_local.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Private planning/AI-instruction docs ---
# Tracked instead by a private repo (turboSwagDonkey/acqApp-notes) sharing
# this working tree via a second .git dir. Physically present on disk (so
# CLAUDE.md still auto-loads and every relative doc link still resolves),
# just not part of this public repo's history going forward. See
# .notes-git/ (the second repo's git dir) and .notes-gitignore.
/.notes-git/
/.notes-gitignore
/CLAUDE.md
/PLAN.md
/docs/SESSIONLOG.md
/docs/DECISIONS.md
/docs/AUDIT-2026-08.md
