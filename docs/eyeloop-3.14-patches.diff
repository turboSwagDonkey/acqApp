diff --git a/eyeloop/constants/engine_constants.py b/eyeloop/constants/engine_constants.py
index f59286b..99a4ca7 100644
--- a/eyeloop/constants/engine_constants.py
+++ b/eyeloop/constants/engine_constants.py
@@ -3,7 +3,8 @@ import numpy as np
 angular_iter = 12
 angular_range = np.arange(angular_iter, dtype=np.int8)
 
-anglesteps_cos = np.array([np.cos(np.radians(i * 360 / angular_iter)) for i in angular_range], dtype=np.float64)
-anglesteps_sin = np.array([np.sin(np.radians(i * 360 / angular_iter)) for i in angular_range], dtype=np.float64)
+# acqApp patch: NEP 50 - np.int8 * python-int stays int8 and 360 overflows.
+anglesteps_cos = np.array([np.cos(np.radians(int(i) * 360 / angular_iter)) for i in angular_range], dtype=np.float64)
+anglesteps_sin = np.array([np.sin(np.radians(int(i) * 360 / angular_iter)) for i in angular_range], dtype=np.float64)
 number_row = np.arange(1, len(anglesteps_cos) + 1, 1)
 zeros = np.zeros(len(number_row), dtype=int)
