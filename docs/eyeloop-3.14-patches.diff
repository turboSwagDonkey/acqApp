+def _put_text_f(img, *args, **kwargs):
+    """acqApp patch: cv2 5 rejects putText on float64, and these label buffers
+    are np.zeros() (float) because the display stack composites them as float.
+    Draw on uint8, convert back -- same values, same dtype."""
+    tmp = np.zeros(img.shape, np.uint8)
+    cv2.putText(tmp, *args, **kwargs)
+    img[...] = tmp.astype(img.dtype)
